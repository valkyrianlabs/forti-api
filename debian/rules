#!/usr/bin/make -f
# Header-only: the meson build installs the headers and forti-api.pc and compiles the umbrella
# header as a check. The test suite needs a live FortiGate, so package builds leave it out.

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Dtests=disabled
