{
 "name": "settings",
 "category": "complex",
 "help": "Configure SSL-VPN.",
 "children": {
  "status": {
   "name": "status",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable SSL-VPN.",
   "options": [
    {
     "name": "enable",
     "help": "Enable SSL-VPN."
    },
    {
     "name": "disable",
     "help": "Disable SSL-VPN."
    }
   ],
   "default": "enable",
   "multiple_values": false
  },
  "reqclientcert": {
   "name": "reqclientcert",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable to require client certificates for all SSL-VPN users.",
   "options": [
    {
     "name": "enable",
     "help": "Enable setting."
    },
    {
     "name": "disable",
     "help": "Disable setting."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "user-peer": {
   "name": "user-peer",
   "category": "unitary",
   "type": "string",
   "help": "Name of user peer.",
   "datasource": [
    "user.peer.name"
   ],
   "size": 35,
   "default": "",
   "multiple_values": false
  },
  "ssl-max-proto-ver": {
   "name": "ssl-max-proto-ver",
   "category": "unitary",
   "type": "option",
   "help": "SSL maximum protocol version.",
   "options": [
    {
     "name": "tls1-0",
     "help": "TLS version 1.0."
    },
    {
     "name": "tls1-1",
     "help": "TLS version 1.1."
    },
    {
     "name": "tls1-2",
     "help": "TLS version 1.2."
    },
    {
     "name": "tls1-3",
     "help": "TLS version 1.3."
    }
   ],
   "default": "tls1-3",
   "multiple_values": false
  },
  "ssl-min-proto-ver": {
   "name": "ssl-min-proto-ver",
   "category": "unitary",
   "type": "option",
   "help": "SSL minimum protocol version.",
   "options": [
    {
     "name": "tls1-0",
     "help": "TLS version 1.0."
    },
    {
     "name": "tls1-1",
     "help": "TLS version 1.1."
    },
    {
     "name": "tls1-2",
     "help": "TLS version 1.2."
    },
    {
     "name": "tls1-3",
     "help": "TLS version 1.3."
    }
   ],
   "default": "tls1-2",
   "multiple_values": false
  },
  "banned-cipher": {
   "name": "banned-cipher",
   "category": "unitary",
   "type": "option",
   "help": "Select one or more cipher technologies that cannot be used in SSL-VPN negotiations. Only applies to TLS 1.2 and below.",
   "options": [
    {
     "name": "RSA",
     "help": "Ban the use of cipher suites using RSA key."
    },
    {
     "name": "DHE",
     "help": "Ban the use of cipher suites using authenticated ephemeral DH key agreement."
    },
    {
     "name": "ECDHE",
     "help": "Ban the use of cipher suites using authenticated ephemeral ECDH key agreement."
    },
    {
     "name": "DSS",
     "help": "Ban the use of cipher suites using DSS authentication."
    },
    {
     "name": "ECDSA",
     "help": "Ban the use of cipher suites using ECDSA authentication."
    },
    {
     "name": "AES",
     "help": "Ban the use of cipher suites using either 128 or 256 bit AES."
    },
    {
     "name": "AESGCM",
     "help": "Ban the use of cipher suites AES in Galois Counter Mode (GCM)."
    },
    {
     "name": "CAMELLIA",
     "help": "Ban the use of cipher suites using either 128 or 256 bit CAMELLIA."
    },
    {
     "name": "3DES",
     "help": "Ban the use of cipher suites using triple DES"
    },
    {
     "name": "SHA1",
     "help": "Ban the use of cipher suites using HMAC-SHA1."
    },
    {
     "name": "SHA256",
     "help": "Ban the use of cipher suites using HMAC-SHA256."
    },
    {
     "name": "SHA384",
     "help": "Ban the use of cipher suites using HMAC-SHA384."
    },
    {
     "name": "STATIC",
     "help": "Ban the use of cipher suites using static keys."
    },
    {
     "name": "CHACHA20",
     "help": "Ban the use of cipher suites using ChaCha20."
    },
    {
     "name": "ARIA",
     "help": "Ban the use of cipher suites using ARIA."
    },
    {
     "name": "AESCCM",
     "help": "Ban the use of cipher suites using AESCCM."
    }
   ],
   "default": "SHA1 SHA256 SHA384",
   "multiple_values": true
  },
  "ciphersuite": {
   "name": "ciphersuite",
   "category": "unitary",
   "type": "option",
   "help": "Select one or more TLS 1.3 ciphersuites to enable. Does not affect ciphers in TLS 1.2 and below. At least one must be enabled. To disable all, set ssl-max-proto-ver to tls1-2 or below.",
   "options": [
    {
     "name": "TLS-AES-128-GCM-SHA256",
     "help": "Enable TLS-AES-128-GCM-SHA256 in TLS 1.3."
    },
    {
     "name": "TLS-AES-256-GCM-SHA384",
     "help": "Enable TLS-AES-256-GCM-SHA384 in TLS 1.3."
    },
    {
     "name": "TLS-CHACHA20-POLY1305-SHA256",
     "help": "Enable TLS-CHACHA20-POLY1305-SHA256 in TLS 1.3."
    },
    {
     "name": "TLS-AES-128-CCM-SHA256",
     "help": "Enable TLS-AES-128-CCM-SHA256 in TLS 1.3."
    },
    {
     "name": "TLS-AES-128-CCM-8-SHA256",
     "help": "Enable TLS-AES-128-CCM-8-SHA256 in TLS 1.3."
    }
   ],
   "default": "TLS-AES-128-GCM-SHA256 TLS-AES-256-GCM-SHA384 TLS-CHACHA20-POLY1305-SHA256",
   "multiple_values": true
  },
  "ssl-insert-empty-fragment": {
   "name": "ssl-insert-empty-fragment",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable insertion of empty fragment.",
   "options": [
    {
     "name": "enable",
     "help": "Enable setting."
    },
    {
     "name": "disable",
     "help": "Disable setting."
    }
   ],
   "default": "enable",
   "multiple_values": false
  },
  "https-redirect": {
   "name": "https-redirect",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable redirect of port 80 to SSL-VPN port.",
   "options": [
    {
     "name": "enable",
     "help": "Enable setting."
    },
    {
     "name": "disable",
     "help": "Disable setting."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "x-content-type-options": {
   "name": "x-content-type-options",
   "category": "unitary",
   "type": "option",
   "help": "Add HTTP X-Content-Type-Options header.",
   "options": [
    {
     "name": "enable",
     "help": "Enable setting."
    },
    {
     "name": "disable",
     "help": "Disable setting."
    }
   ],
   "default": "enable",
   "multiple_values": false
  },
  "ssl-client-renegotiation": {
   "name": "ssl-client-renegotiation",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable to allow client renegotiation by the server if the tunnel goes down.",
   "options": [
    {
     "name": "disable",
     "help": "Abort any SSL connection that attempts to renegotiate."
    },
    {
     "name": "enable",
     "help": "Allow a SSL client to renegotiate."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "force-two-factor-auth": {
   "name": "force-two-factor-auth",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable only PKI users with two-factor authentication for SSL-VPNs.",
   "options": [
    {
     "name": "enable",
     "help": "Enable setting."
    },
    {
     "name": "disable",
     "help": "Disable setting."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "unsafe-legacy-renegotiation": {
   "name": "unsafe-legacy-renegotiation",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable unsafe legacy re-negotiation.",
   "options": [
    {
     "name": "enable",
     "help": "Enable setting."
    },
    {
     "name": "disable",
     "help": "Disable setting."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "servercert": {
   "name": "servercert",
   "category": "unitary",
   "type": "string",
   "help": "Name of the server certificate to be used for SSL-VPNs.",
   "datasource": [
    "vpn.certificate.local.name"
   ],
   "size": 35,
   "default": "",
   "multiple_values": false
  },
  "algorithm": {
   "name": "algorithm",
   "category": "unitary",
   "type": "option",
   "help": "Force the SSL-VPN security level. High allows only high. Medium allows medium and high. Low allows any.",
   "options": [
    {
     "name": "high",
     "help": "High algorithms."
    },
    {
     "name": "medium",
     "help": "High and medium algorithms."
    },
    {
     "name": "default",
     "help": "default",
     "missing_help": true
    },
    {
     "name": "low",
     "help": "All algorithms."
    }
   ],
   "default": "high",
   "multiple_values": false
  },
  "idle-timeout": {
   "name": "idle-timeout",
   "category": "unitary",
   "type": "integer",
   "help": "SSL-VPN disconnects if idle for specified time in seconds.",
   "min-value": 0,
   "max-value": 259200,
   "default": 300,
   "multiple_values": false
  },
  "auth-timeout": {
   "name": "auth-timeout",
   "category": "unitary",
   "type": "integer",
   "help": "SSL-VPN authentication timeout (1 - 259200 sec (3 days), 0 for no timeout).",
   "min-value": 0,
   "max-value": 259200,
   "default": 28800,
   "multiple_values": false
  },
  "login-attempt-limit": {
   "name": "login-attempt-limit",
   "category": "unitary",
   "type": "integer",
   "help": "SSL-VPN maximum login attempt times before block (0 - 10, default = 2, 0 = no limit).",
