   "name": "dtls-hello-timeout",
   "category": "unitary",
   "type": "integer",
   "help": "SSLVPN maximum DTLS hello timeout (10 - 60 sec, default = 10).",
   "min-value": 10,
   "max-value": 60,
   "default": 10,
   "multiple_values": false
  },
  "dtls-heartbeat-idle-timeout": {
   "name": "dtls-heartbeat-idle-timeout",
   "category": "unitary",
   "type": "integer",
