{
 "name": "modem",
 "category": "complex",
 "help": "Configure MODEM.",
 "children": {
  "status": {
   "name": "status",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable Modem support (equivalent to bringing an interface up or down).",
   "required": true,
   "options": [
    {
     "name": "enable",
     "help": "Enable setting."
    },
    {
     "name": "disable",
     "help": "Disable setting."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "pin-init": {
   "name": "pin-init",
   "category": "unitary",
   "type": "string",
   "help": "AT command to set the PIN (AT+PIN=<pin>).",
   "size": 127,
   "default": "",
   "multiple_values": false
  },
  "network-init": {
   "name": "network-init",
   "category": "unitary",
   "type": "string",
   "help": "AT command to set the Network name/type (AT+COPS=<mode>,[<format>,<oper>[,<AcT>]]).",
   "size": 127,
   "default": "",
   "multiple_values": false
  },
  "lockdown-lac": {
   "name": "lockdown-lac",
   "category": "unitary",
   "type": "string",
   "help": "Allow connection only to the specified Location Area Code (LAC).",
   "size": 127,
   "default": "",
   "multiple_values": false
  },
  "mode": {
   "name": "mode",
   "category": "unitary",
   "type": "option",
   "help": "Set MODEM operation mode to redundant or standalone.",
   "required": true,
   "options": [
    {
     "name": "standalone",
     "help": "Standalone."
    },
    {
     "name": "redundant",
     "help": "Redundant for an interface."
    }
   ],
   "default": "standalone",
   "multiple_values": false
  },
  "auto-dial": {
   "name": "auto-dial",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable auto-dial after a reboot or disconnection.",
   "options": [
    {
     "name": "enable",
     "help": "Enable setting."
    },
    {
     "name": "disable",
     "help": "Disable setting."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "dial-on-demand": {
   "name": "dial-on-demand",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable to dial the modem when packets are routed to the modem interface.",
   "options": [
    {
     "name": "enable",
     "help": "Enable setting."
    },
    {
     "name": "disable",
     "help": "Disable setting."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "idle-timer": {
   "name": "idle-timer",
   "category": "unitary",
   "type": "integer",
   "help": "MODEM connection idle time (1 - 9999 min, default = 5).",
   "min-value": 1,
   "max-value": 9999,
   "default": 5,
   "multiple_values": false
  },
  "redial": {
   "name": "redial",
   "category": "unitary",
   "type": "option",
   "help": "Redial limit (1 - 10 attempts, none = redial forever).",
   "options": [
    {
     "name": "none",
     "help": "Forever."
    },
    {
     "name": "1",
     "help": "One attempt."
    },
    {
     "name": "2",
     "help": "Two attempts."
    },
    {
     "name": "3",
     "help": "Three attempts."
    },
    {
     "name": "4",
     "help": "Four attempts."
    },
    {
     "name": "5",
     "help": "Five attempts."
    },
    {
     "name": "6",
     "help": "Six attempts."
    },
    {
     "name": "7",
     "help": "Seven attempts."
    },
    {
     "name": "8",
     "help": "Eight attempts."
    },
    {
     "name": "9",
     "help": "Nine attempts."
    },
    {
     "name": "10",
     "help": "Ten attempts."
    }
   ],
   "default": "none",
   "multiple_values": false
  },
  "reset": {
   "name": "reset",
   "category": "unitary",
   "type": "integer",
   "help": "Number of dial attempts before resetting modem (0 = never reset).",
   "min-value": 0,
   "max-value": 10,
   "default": 0,
   "multiple_values": false
  },
  "holddown-timer": {
   "name": "holddown-timer",
   "category": "unitary",
   "type": "integer",
   "help": "Hold down timer in seconds (1 - 60 sec).",
   "min-value": 1,
   "max-value": 60,
   "default": 60,
   "multiple_values": false
  },
  "connect-timeout": {
   "name": "connect-timeout",
   "category": "unitary",
   "type": "integer",
   "help": "Connection completion timeout (30 - 255 sec, default = 90).",
   "min-value": 30,
   "max-value": 255,
   "default": 90,
   "multiple_values": false
  },
  "interface": {
   "name": "interface",
   "category": "unitary",
   "type": "string",
   "help": "Name of redundant interface.",
   "required": true,
   "datasource": [
    "system.interface.name"
   ],
   "size": 63,
   "default": "",
   "multiple_values": false
  },
  "wireless-port": {
   "name": "wireless-port",
   "category": "unitary",
   "type": "integer",
   "help": "Enter wireless port number: 0 for default, 1 for first port, and so on (0 - 4294967295).",
   "min-value": 0,
   "max-value": 4294967295,
   "default": 0,
   "multiple_values": false
  },
  "dont-send-CR1": {
   "name": "dont-send-CR1",
