{
 "name": "dns-server",
 "category": "table",
 "help": "Configure DNS servers.",
 "mkey": "name",
 "mkey_type": "string",
 "children": {
  "name": {
   "name": "name",
   "category": "unitary",
   "type": "string",
   "help": "DNS server name.",
   "datasource": [
    "system.interface.name"
   ],
   "size": 15,
   "default": "",
   "multiple_values": false
  },
  "mode": {
   "name": "mode",
   "category": "unitary",
   "type": "option",
   "help": "DNS server mode.",
   "options": [
    {
     "name": "recursive",
     "help": "Shadow DNS database and forward."
    },
    {
     "name": "non-recursive",
     "help": "Public DNS database only."
    },
    {
     "name": "forward-only",
     "help": "Forward only."
    }
   ],
   "default": "recursive",
   "multiple_values": false
  },
  "dnsfilter-profile": {
   "name": "dnsfilter-profile",
   "category": "unitary",
   "type": "string",
   "help": "DNS filter profile.",
   "datasource": [
    "dnsfilter.profile.name"
   ],
   "size": 35,
   "default": "",
   "multiple_values": false
  },
  "doh": {
   "name": "doh",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable DNS over HTTPS/443 (default = disable).",
   "options": [
    {
     "name": "enable",
     "help": "Enable DNS over HTTPS."
    },
    {
     "name": "disable",
     "help": "Disable DNS over HTTPS."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "doh3": {
   "name": "doh3",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable DNS over QUIC/HTTP3/443 (default = disable).",
   "options": [
    {
     "name": "enable",
     "help": "Enable DNS over HTTP3/QUIC."
    },
    {
     "name": "disable",
     "help": "Disable DNS over HTTP3/QUIC."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "doq": {
   "name": "doq",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable DNS over QUIC/853 (default = disable).",
   "options": [
    {
     "name": "enable",
     "help": "Enable DNS over QUIC."
    },
    {
     "name": "disable",
     "help": "Disable DNS over QUIC."
    }
   ],
   "default": "disable",
   "multiple_values": false
  }
 },
 "max_table_size_vdom": 256,
 "max_table_size_global": 512,
 "max_table_size_item": 0,
 "path": "system",
 "q_type": 466,
 "access_group": "sysgrp",
 "object_range": "vdom"
}
