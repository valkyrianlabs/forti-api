  "duplicate-ssid": {
   "name": "duplicate-ssid",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable allowing Virtual Access Points (VAPs) to use the same SSID name in the same VDOM.",
   "options": [
    {
     "name": "enable",
     "help": "Allow VAPs to use the same SSID name in the same VDOM."
    },
    {
     "name": "disable",
     "help": "Do not allow VAPs to use the same SSID name in the same VDOM."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "fapc-compatibility": {
   "name": "fapc-compatibility",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable FAP-C series compatibility.",
   "options": [
    {
     "name": "enable",
     "help": "Enable FAP-C series compatibility."
    },
    {
     "name": "disable",
     "help": "Disable FAP-C series compatibility."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "wfa-compatibility": {
   "name": "wfa-compatibility",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable WFA compatibility.",
   "options": [
    {
     "name": "enable",
     "help": "Enable Wi-Fi Alliance Certification compatibility."
    },
    {
     "name": "disable",
     "help": "Disable Wi-Fi Alliance Certification compatibility."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "phishing-ssid-detect": {
   "name": "phishing-ssid-detect",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable phishing SSID detection.",
   "options": [
    {
     "name": "enable",
     "help": "Enable phishing SSID detection."
    },
    {
     "name": "disable",
     "help": "Disable phishing SSID detection."
    }
   ],
   "default": "enable",
   "multiple_values": false
  },
  "fake-ssid-action": {
   "name": "fake-ssid-action",
   "category": "unitary",
   "type": "option",
   "help": "Actions taken for detected fake SSID.",
   "options": [
    {
     "name": "log",
     "help": "Write logs for detected fake SSID."
    },
    {
     "name": "suppress",
     "help": "Suppress detected fake SSID."
    }
   ],
   "default": "log",
   "multiple_values": true
  },
  "offending-ssid": {
   "name": "offending-ssid",
   "category": "table",
   "help": "Configure offending SSID.",
   "mkey": "id",
   "mkey_type": "integer",
   "children": {
    "id": {
     "name": "id",
     "category": "unitary",
     "type": "integer",
     "help": "ID.",
     "min-value": 0,
     "max-value": 65535,
     "default": 0,
     "multiple_values": false
    },
    "ssid-pattern": {
     "name": "ssid-pattern",
     "category": "unitary",
     "type": "string",
     "help": "Define offending SSID pattern (case insensitive). For example, word, word*, *word, wo*rd.",
     "required": true,
     "size": 33,
     "default": "",
     "multiple_values": false
    },
    "action": {
     "name": "action",
     "category": "unitary",
     "type": "option",
     "help": "Actions taken for detected offending SSID.",
     "options": [
      {
       "name": "log",
       "help": "Generate logs for detected offending SSID."
      },
      {
       "name": "suppress",
       "help": "Suppress detected offending SSID."
      }
     ],
     "default": "log",
     "multiple_values": true
    }
   },
   "max_table_size_vdom": 128,
   "max_table_size_global": 0,
   "max_table_size_item": 0
  },
  "device-weight": {
   "name": "device-weight",
   "category": "unitary",
   "type": "integer",
   "help": "Upper limit of confidence of device for identification (0 - 255, default = 1, 0 = disable).",
   "min-value": 0,
   "max-value": 255,
   "default": 1,
   "multiple_values": false
  },
  "device-holdoff": {
   "name": "device-holdoff",
   "category": "unitary",
   "type": "integer",
   "help": "Lower limit of creation time of device for identification in minutes (0 - 60, default = 5).",
   "min-value": 0,
   "max-value": 60,
   "default": 5,
   "multiple_values": false
  },
  "device-idle": {
   "name": "device-idle",
   "category": "unitary",
   "type": "integer",
   "help": "Upper limit of idle time of device for identification in minutes (0 - 14400, default = 1440).",
   "min-value": 0,
   "max-value": 14400,
   "default": 1440,
   "multiple_values": false
  },
  "firmware-provision-on-authorization": {
   "name": "firmware-provision-on-authorization",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable automatic provisioning of latest firmware on authorization.",
   "options": [
    {
     "name": "enable",
     "help": "Enable firmware provision on authorization."
    },
    {
     "name": "disable",
     "help": "Disable firmware provision on authorization."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "rolling-wtp-upgrade": {
   "name": "rolling-wtp-upgrade",
   "category": "unitary",
   "type": "option",
   "help": "Enable/disable rolling WTP upgrade (default = disable).",
   "options": [
    {
     "name": "enable",
     "help": "Enable rolling WTP upgrade."
    },
    {
     "name": "disable",
     "help": "Disable rolling WTP upgrade."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "darrp-optimize": {
   "name": "darrp-optimize",
   "category": "unitary",
   "type": "integer",
   "help": "Time for running Distributed Automatic Radio Resource Provisioning (DARRP) optimizations (0 - 86400 sec, default = 86400, 0 = disable).",
   "min-value": 0,
   "max-value": 86400,
   "default": 86400,
   "multiple_values": false
  },
  "darrp-optimize-schedules": {
   "name": "darrp-optimize-schedules",
   "category": "table",
