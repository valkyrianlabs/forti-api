     "help": "Disable syslog server."
    }
   ],
   "default": "enable",
   "multiple_values": false
  },
  "server-addr-type": {
   "name": "server-addr-type",
   "category": "unitary",
   "type": "option",
   "help": "Syslog server address type (default = ip).",
   "options": [
    {
     "name": "fqdn",
     "help": "Fully Qualified Domain Name address."
    },
    {
     "name": "ip",
     "help": "IPv4 address."
    }
   ],
   "default": "ip",
   "multiple_values": false
  },
  "server-fqdn": {
   "name": "server-fqdn",
   "category": "unitary",
   "type": "string",
