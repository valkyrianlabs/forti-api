    },
    "altitude-unit": {
     "name": "altitude-unit",
     "category": "unitary",
     "type": "option",
     "help": "Configure the unit for which the altitude is to (m = meters, f = floors of a building).",
     "required": true,
     "options": [
      {
       "name": "m",
       "help": "set altitude unit meters"
      },
      {
       "name": "f",
       "help": "set altitude unit floors"
      }
     ],
     "default": "m",
     "multiple_values": false
    },
    "datum": {
     "name": "datum",
     "category": "unitary",
     "type": "option",
     "help": "WGS84, NAD83, NAD83/MLLW.",
     "required": true,
     "options": [
      {
       "name": "WGS84",
       "help": "set coordinates datum WGS84"
      },
      {
       "name": "NAD83",
       "help": "set coordinates datum NAD83"
      },
      {
       "name": "NAD83/MLLW",
       "help": "set coordinates datum NAD83/MLLW"
      }
     ],
