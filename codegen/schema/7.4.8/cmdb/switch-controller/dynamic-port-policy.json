   "help": "FortiLink interface for which this Dynamic port policy belongs to.",
   "required": true,
   "datasource": [
    "system.interface.name"
   ],
   "size": 15,
   "default": "",
   "multiple_values": false
  },
  "policy": {
   "name": "policy",
   "category": "table",
   "help": "Port policies with matching criteria and actions.",
   "mkey": "name",
   "mkey_type": "string",
