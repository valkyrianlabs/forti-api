    "name": {
     "name": "name",
     "category": "unitary",
     "type": "string",
     "help": "Policy name.",
     "required": true,
     "size": 63,
     "default": "",
     "multiple_values": false
    },
    "description": {
     "name": "description",
     "category": "unitary",
     "type": "string",
     "help": "Description for the policy.",
     "size": 63,
     "default": "",
     "multiple_values": false
    },
    "status": {
     "name": "status",
     "category": "unitary",
     "type": "option",
     "help": "Enable/disable policy.",
     "options": [
      {
       "name": "enable",
       "help": "Enable policy."
      },
      {
       "name": "disable",
       "help": "Disable policy."
      }
     ],
     "default": "enable",
     "multiple_values": false
    },
    "category": {
     "name": "category",
     "category": "unitary",
     "type": "option",
     "help": "Category of Dynamic port policy.",
     "options": [
      {
       "name": "device",
       "help": "Device category."
      },
      {
       "name": "interface-tag",
       "help": "Interface Tag category."
      }
     ],
     "default": "device",
     "multiple_values": false
    },
    "match-type": {
     "name": "match-type",
     "category": "unitary",
     "type": "option",
     "help": "Match and retain the devices based on the type.",
     "options": [
      {
       "name": "dynamic",
       "help": "Matched devices will be removed on dynamic events like link-down,device-inactivity,switch-offline."
      },
      {
       "name": "override",
       "help": "Matched devices will be retained until the match-period."
      }
     ],
     "default": "dynamic",
     "multiple_values": false
    },
    "match-period": {
     "name": "match-period",
     "category": "unitary",
     "type": "integer",
     "help": "Number of days the matched devices will be retained (0 - 120, 0 = always retain).",
     "min-value": 0,
     "max-value": 120,
     "default": 0,
     "multiple_values": false
    },
    "interface-tags": {
     "name": "interface-tags",
     "category": "table",
