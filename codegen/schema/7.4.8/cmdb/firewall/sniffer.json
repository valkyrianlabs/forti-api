   "help": "Enable/disable antivirus profile.",
   "options": [
    {
     "name": "enable",
     "help": "Enable setting."
    },
    {
     "name": "disable",
     "help": "Disable setting."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "av-profile": {
   "name": "av-profile",
