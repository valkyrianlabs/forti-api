   "name": "est-regeneration-method",
   "category": "unitary",
   "type": "option",
   "help": "EST behavioral options during re-enrollment.",
   "options": [
    {
     "name": "create-new-key",
     "help": "Create new private key during re-enrollment."
    },
    {
     "name": "use-existing-key",
     "help": "Reuse existing private key during re-enrollment."
    }
   ],
   "default": "create-new-key",
   "multiple_values": false
  },
  "details": {
   "name": "details",
   "category": "info-read-only",
   "type": "key",
