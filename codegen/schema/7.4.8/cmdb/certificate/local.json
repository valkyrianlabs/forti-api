   "default": "",
   "multiple_values": false
  },
  "name-encoding": {
   "name": "name-encoding",
   "category": "unitary",
   "type": "option",
   "help": "Name encoding method for auto-regeneration.",
   "options": [
    {
     "name": "printable",
     "help": "Printable encoding (default)."
