   "name": "cmp-regeneration-method",
   "category": "unitary",
   "type": "option",
   "help": "CMP auto-regeneration method.",
   "options": [
    {
     "name": "keyupate",
     "help": "Key Update."
    },
    {
     "name": "renewal",
     "help": "Renewal."
    }
   ],
   "default": "keyupate",
   "multiple_values": false
  },
  "acme-ca-url": {
   "name": "acme-ca-url",
   "category": "unitary",
   "type": "string",
   "help": "The URL for the ACME CA server (Let's Encrypt is the default provider).",
   "required": true,
   "size": 255,
   "default": "https://acme-v02.api.letsencrypt.org/directory",
   "multiple_values": false
  },
  "acme-domain": {
   "name": "acme-domain",
   "category": "unitary",
   "type": "string",
   "help": "A valid domain that resolves to this FortiGate unit.",
   "required": true,
   "size": 255,
   "default": "",
   "multiple_values": false
  },
  "acme-email": {
   "name": "acme-email",
   "category": "unitary",
   "type": "string",
