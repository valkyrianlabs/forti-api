   "size": 63,
   "default": "",
   "multiple_values": false
  },
  "cmp-path": {
   "name": "cmp-path",
   "category": "unitary",
   "type": "string",
   "help": "Path location inside CMP server.",
   "size": 255,
   "default": "",
   "multiple_values": false
  },
