   "options": [
    {
     "name": "enable",
     "help": "Keep the existing private key during SCEP renewal."
    },
    {
     "name": "disable",
     "help": "Generate a new private key during SCEP renewal."
    }
   ],
   "default": "disable",
   "multiple_values": false
  },
  "cmp-server": {
   "name": "cmp-server",
   "category": "unitary",
   "type": "string",
