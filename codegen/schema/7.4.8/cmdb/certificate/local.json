    {
     "name": "global",
     "help": "Global range."
    },
    {
     "name": "vdom",
     "help": "VDOM IP address range."
    }
   ],
   "default": "global",
   "multiple_values": false
  },
  "source": {
   "name": "source",
   "category": "unitary",
   "type": "option",
