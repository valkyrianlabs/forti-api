   "max-value": 4294967295,
   "default": 0,
   "multiple_values": false
  },
  "scep-password": {
   "name": "scep-password",
   "category": "unitary",
   "type": "password",
   "help": "SCEP server challenge password for auto-regeneration.",
   "size": 128,
   "multiple_values": false
  },
  "ca-identifier": {
   "name": "ca-identifier",
   "category": "unitary",
   "type": "string",
