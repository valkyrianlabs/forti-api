   "default": "",
   "multiple_values": false
  },
  "est-ca-id": {
   "name": "est-ca-id",
   "category": "unitary",
   "type": "string",
   "help": "CA identifier of the CA server for signing via EST.",
   "size": 255,
   "default": "",
   "multiple_values": false
  },
  "est-http-username": {
   "name": "est-http-username",
   "category": "unitary",
