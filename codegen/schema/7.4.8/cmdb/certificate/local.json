    "certificate.ca.name",
    "certificate.remote.name"
   ],
   "size": 79,
   "default": "",
   "multiple_values": false
  },
  "est-srp-username": {
   "name": "est-srp-username",
   "category": "unitary",
   "type": "string",
   "help": "EST SRP authentication username.",
   "size": 63,
   "default": "",
   "multiple_values": false
  },
  "est-srp-password": {
   "name": "est-srp-password",
   "category": "unitary",
   "type": "password",
   "help": "EST SRP authentication password.",
   "size": 128,
   "multiple_values": false
  },
