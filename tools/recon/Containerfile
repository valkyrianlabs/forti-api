# Recon recorder image: Microsoft's Playwright image (browsers + system libraries, pinned by
# digest) plus the matching Python package. Built and run by tools/recon/run.sh on the dev box.
FROM mcr.microsoft.com/playwright/python:v1.58.0-noble@sha256:678457c4c323b981d8b4befc57b95366bb1bb6aa30057b1269f6b171e8d9975a
RUN python3 -m pip install --no-cache-dir --break-system-packages --root-user-action=ignore playwright==1.58.0 \
 && python3 -c "import playwright.sync_api" && python3 -m pip show playwright | head -2
