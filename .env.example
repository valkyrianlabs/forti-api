# Read by fortiapi::Config::from_env() (and the live test suite).
FORTIGATE_HOST=fortigate.example.com
FORTIGATE_ADMIN_HTTPS_PORT=443
FORTIGATE_API_KEY=abcd1234abcd1234
# Optional: connect to this address while verifying TLS for FORTIGATE_HOST (split-horizon DNS).
FORTIGATE_RESOLVE_IP=
# Optional: PEM CA bundle; empty uses the system trust store.
PATH_TO_FORTIGATE_CA_CERT=
# Optional: PKCS#12 client certificate for PKI peer authentication (absolute path).
PATH_TO_FORTIGATE_SSL_CERT=
FORTIGATE_SSL_CERT_PASS=
# Optional: default VDOM for every request.
FORTIGATE_VDOM=
